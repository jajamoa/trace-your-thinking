# Example environment variables file
# Copy this to the parent directory as .env.local and fill in your actual values

# Required: Dashscope API key for LLM operations
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: Maximum QA count for conversations (default: 50)
MAX_QA_COUNT=50

# Optional: Default topic for stance nodes (default: "climate change")
DEFAULT_TOPIC=climate change

# Optional: Enable debug LLM I/O logging (default: false)
DEBUG_LLM_IO=false

# Optional: Flask environment (default: development)
FLASK_ENV=development
